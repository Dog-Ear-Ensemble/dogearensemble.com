<footer class="site-footer">
  <p>
    <a href="{{ "/" | relative_url }}">Home</a>
    <span class="sep">|</span>
    <a href="{{ "/privacy/" | relative_url }}">Privacy</a>
    <span class="sep">|</span>
    <a href="{{ site.sponsor_url }}">Support on GitHub Sponsors</a>
    {% if site.source_public %}
    <span class="sep">|</span>
    <a href="{{ site.source_url }}">Source on GitHub</a>
    {% endif %}
  </p>
  <p>&copy; {{ "now" | date: "%Y" }} {{ site.author_name }}. {{ site.title }} is open source under the MIT license.</p>
  <p>This site uses no cookies, trackers, or analytics.</p>
</footer>
