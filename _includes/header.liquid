<header class="site-header">
  <a class="wordmark" href="{{ "/" | relative_url }}">
    <img src="{{ "/assets/favicon.png" | relative_url }}" alt="" width="28" height="28">
    {{ site.title }}
  </a>
  <nav class="site-nav" aria-label="Main">
    <ul>
      {% for item in site.menu %}
      <li><a href="{{ item.url | relative_url }}">{{ item.name }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</header>
