<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if page.url == "/" %}{{ site.title }}{% else %}{{ page.title }}: {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ page.description | default: site.description }}">
  <meta name="author" content="{{ site.author_name }}">
  <meta name="keywords" content="{{ site.keywords }}">
  <meta name="color-scheme" content="light dark">
  {% include opengraph.liquid %}
  <link rel="canonical" href="{{ page.url | absolute_url }}">
  <link rel="icon" href="{{ "/assets/favicon.ico" | relative_url }}" sizes="any">
  <link rel="icon" type="image/png" href="{{ "/assets/favicon.png" | relative_url }}">
  <link rel="apple-touch-icon" href="{{ "/assets/apple-touch-icon.png" | relative_url }}">
  <link rel="stylesheet" href="{{ "/assets/style.css" | relative_url }}?v={{ site.time | date: '%s' }}">
</head>
